{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(scripts/*)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun simctl:*)",
      "Bash(xcrun devicectl list:*)",
      "Bash(xcodegen:*)",
      "Bash(swiftlint:*)",
      "Bash(swift-format:*)",
      "Bash(./gradlew:*)",
      "Bash(adb:*)",
      "Bash(emulator:*)",
      "Bash(ktlint:*)",
      "Bash(maestro:*)",
      "Bash(pnpm:*)",
      "Bash(npx wrangler dev:*)",
      "Bash(ffmpeg:*)",
      "Bash(ffprobe:*)",
      "Bash(uv run:*)",
      "Bash(docker compose:*)",
      "Bash(jq:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "mcp__XcodeBuildMCP",
      "mcp__mobile-mcp"
    ],
    "deny": [
      "Read(./**/*.p8)",
      "Read(./**/*.p12)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/.dev.vars)",
      "Read(./**/Secrets.xcconfig)",
      "Read(./**/google-services.json)",
      "Read(./**/GoogleService-Info.plist)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session_start.sh", "timeout": 30 } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_bash.sh", "timeout": 10 } ] },
      { "matcher": "Edit|Write|MultiEdit|NotebookEdit", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard_paths.sh", "timeout": 10 } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post_edit.sh", "timeout": 60 } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop_verify.sh", "timeout": 1500 } ] }
    ]
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clearcall",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // ≤ 1 TURN credential mint per client IP per minute (cache misses only; see src/ice.ts).
  "ratelimits": [
    { "name": "TURN_MINT_LIMITER", "namespace_id": "1001", "simple": { "limit": 1, "period": 60 } }
  ],
  // Local dev only: enables /api/dev/config + /api/dev/log. Must stay "0" in deployed envs.
  "vars": { "DEV_TELEMETRY": "1" },
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "clearcall-staging",
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
      "ratelimits": [
        { "name": "TURN_MINT_LIMITER", "namespace_id": "1001", "simple": { "limit": 1, "period": 60 } }
      ],
      "vars": { "DEV_TELEMETRY": "0" }
    },
    "production": {
      "name": "clearcall",
      "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
      "ratelimits": [
        { "name": "TURN_MINT_LIMITER", "namespace_id": "1001", "simple": { "limit": 1, "period": 60 } }
      ],
      "vars": { "DEV_TELEMETRY": "0" }
    }
  }
}
